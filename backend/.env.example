# Copy this file to .env and fill in your values

# Supabase connection string: Supabase dashboard -> Connect -> Session pooler
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Frontend URL allowed to call this API (comma-separate several)
CORS_ORIGIN=http://localhost:3000

PORT=4000
