# =========================================================
#  Daily Expense Tracker: single .gitignore for the whole repo
#  1. Common (every part of the project)
#  2. Node.js / npm
#  3. TypeScript
#  4. Backend: Express + TypeScript   (backend/)
#  5. Frontend: Next.js + React       (frontend/)
#  6. Hosting: Vercel / Render
#  7. Claude Code (personal files only)
# =========================================================


# ---------------------------------------------------------
# 1. Common
# ---------------------------------------------------------

# Environment variables & secrets (keep the .env.example templates)
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editors / IDEs (shared VS Code settings are allowed)
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Test coverage
coverage/
.nyc_output/


# ---------------------------------------------------------
# 2. Node.js / npm
# ---------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js
.npm/
*.pid


# ---------------------------------------------------------
# 3. TypeScript
# ---------------------------------------------------------
*.tsbuildinfo


# ---------------------------------------------------------
# 4. Backend: Node.js + Express + TypeScript
# ---------------------------------------------------------

# Compiled output from `npm run build` (tsc)
backend/dist/
backend/build/


# ---------------------------------------------------------
# 5. Frontend: Next.js + React + TypeScript
# ---------------------------------------------------------

# Next.js build output
frontend/.next/
frontend/out/
frontend/build/

# Auto-generated by Next.js on every build
frontend/next-env.d.ts


# ---------------------------------------------------------
# 6. Hosting
# ---------------------------------------------------------
.vercel/
.render/


# ---------------------------------------------------------
# 7. Claude Code
#    Shared files ARE committed: CLAUDE.md, .claude/settings.json,
#    .claude/hooks/, .claude/skills/
# ---------------------------------------------------------
.claude/settings.local.json
CLAUDE.local.md
Claude outputs/
