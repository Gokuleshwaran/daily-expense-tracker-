# =========================================================
#  Common ignores for the whole project
#  (backend/ and frontend/ have their own technology-specific files)
# =========================================================

# ---- Dependencies ----
node_modules/

# ---- Environment variables & secrets (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- TypeScript build info ----
*.tsbuildinfo

# ---- Test coverage ----
coverage/

# ---- OS files ----
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ---- Editors / IDEs ----
.idea/
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- Claude: personal (local) files only ----
# Shared Claude files (CLAUDE.md, .claude/settings.json, .claude/skills/) ARE committed
.claude/settings.local.json
CLAUDE.local.md
Claude outputs/
